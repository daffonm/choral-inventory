rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Pastikan user sudah login
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: Validasi integritas data persediaan
    function isValidInventoryItem() {
      let data = request.resource.data;
      return data.sku is string && data.sku.size() > 0
          && data.namaProduk is string && data.namaProduk.size() > 0
          && data.totalStock is int && data.totalStock >= 0
          && data.availableStock is int && data.availableStock >= 0;
    }

    // 1. Koleksi Inventaris & Persediaan
    match /inventory/{itemId} {
      // Hanya pengguna yang sudah login yang bisa membaca data stok
      allow read: if isAuthenticated();
      
      // Tambah & edit stok wajib tervalidasi dan dilakukan oleh user terautentikasi
      allow create, update: if isAuthenticated() && isValidInventoryItem();
      
      // Hapus barang hanya diizinkan untuk akun terotentikasi internal
      allow delete: if isAuthenticated();
    }

    // 2. Koleksi Mutasi & Pergerakan Stok (Audit Trail)
    match /stock_movements/{movementId} {
      allow read: if isAuthenticated();
      // Boleh dicatat saat ada transaksi
      allow create: if isAuthenticated() 
                    && request.resource.data.quantity is int
                    && request.resource.data.sku is string;
      // Mutasi bersifat immutable: dilarang edit atau hapus riwayat audit log
      allow update, delete: if false;
    }

    // Default deny untuk koleksi lainnya demi keamanan
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
