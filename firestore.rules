rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Pastikan user sudah login
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Koleksi Inventaris & Persediaan
    match /inventory/{itemId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 2. Koleksi Mutasi & Pergerakan Stok (Audit Trail)
    match /stock_movements/{movementId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Mutasi bersifat immutable: dilarang edit atau hapus riwayat audit log
      allow update, delete: if false;
    }

    // 3. Koleksi Stock Opname & Audit Fisik
    match /stock_opname/{opnameId} {
      allow read, write: if isAuthenticated();
    }

    // 4. Koleksi Master Data
    match /master_products/{id} {
      allow read, write: if isAuthenticated();
    }
    match /master_materials/{id} {
      allow read, write: if isAuthenticated();
    }
    match /master_suppliers/{id} {
      allow read, write: if isAuthenticated();
    }
    match /master_warehouses/{id} {
      allow read, write: if isAuthenticated();
    }
    match /master_channels/{id} {
      allow read, write: if isAuthenticated();
    }

    // 5. Koleksi Barang Masuk (Inbound)
    match /incoming_goods/{id} {
      allow read, write: if isAuthenticated();
    }

    // 6. Koleksi Produksi & Manufaktur
    match /production_orders/{id} {
      allow read, write: if isAuthenticated();
    }

    // 7. Koleksi Pesanan & Fulfillment (Outbound)
    match /orders/{id} {
      allow read, write: if isAuthenticated();
    }

    // 8. Koleksi Transaksi & Mutasi Pengeluaran
    match /transactions/{id} {
      allow read, write: if isAuthenticated();
    }

    // 9. Koleksi Aktivitas Sistem & Log Operasional
    match /activities/{id} {
      allow read, write: if isAuthenticated();
    }

    // Default deny untuk koleksi luar lainnya demi keamanan
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
